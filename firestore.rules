rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/europe-2026/expenses/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['day','amount','person','note','createdAt','deleted'])
        && request.resource.data.day in ['1','2','3','4','5','6','7','8','9']
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
        && request.resource.data.person is string && request.resource.data.person.size() <= 30
        && request.resource.data.note is string && request.resource.data.note.size() <= 80
        && request.resource.data.createdAt is number && request.resource.data.deleted is bool;
    }
    match /trips/europe-2026/days/{day} {
      allow read: if true;
      allow create, update: if day in ['1','2','3','4','5','6','7','8','9']
        && request.resource.data.keys().hasOnly(['rows','revision'])
        && request.resource.data.rows is list && request.resource.data.rows.size() <= 60
        && request.resource.data.revision is int && request.resource.data.revision > 0;
    }
  }
}
